# Bitbucket API Configuration
BITBUCKET_URL="https://api.bitbucket.org/2.0"

# Workspace and Repository
WORKSPACE="your-workspace"
REPO_SLUG="your-repository"

# Authentication - Bitbucket API Token
# Get your API token from: https://bitbucket.org/account/settings/app-passwords/
# Required permissions: account:read, repository:read, pullrequest:read, repository:write
API_TOKEN="your-api-token-here"

# Default Reviewers UUIDs (optional - will be fetched if not provided)
# Get UUIDs using: ./scripts/utils/get-user-uuids.sh username
REVIEWER_JABES_FUENTES_UUID=""
REVIEWER_JHON_VALDERRAMA_UUID=""
REVIEWER_JOSE_OPAZO_UUID=""
REVIEWER_JUAN_PUGA_UUID=""
REVIEWER_KAREN_SUDZUKI_UUID=""
REVIEWER_LUIS_CRUZ_UUID=""
REVIEWER_PATRICIO_SANHUEZA_UUID=""
REVIEWER_ROGELIO_CISTERNAS_UUID=""